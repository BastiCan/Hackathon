# Rutas relativas a la raíz del repo, o absolutas.

# Datos públicos del dataset E-1
DATASET_DIR=Dump/dataset_e1_publico/datos_publicos

# Build del frontend (npm run build). Si existe, la API también sirve la app web.
FRONTEND_DIST=frontend/dist

# Proveedor de IA: "mock" (demo, sin red) o "bedrock" (requiere credenciales AWS)
AI_PROVIDER=mock
